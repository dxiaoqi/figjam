{
  "name": "ai-figma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A local-first infinite canvas shared by people and AI agents (Phase 0 prototype)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "bin": {
    "aifig": "bin/aifig.mjs"
  },
  "scripts": {
    "dev": "concurrently -k -n core,ui -c magenta,cyan \"npm:core\" \"npm:ui\"",
    "dev:clean": "concurrently -k -n core,ui -c magenta,cyan \"npm:core\" \"npm run dev:clean -w @aifig/canvas\"",
    "core": "node bin/aifig.mjs core",
    "ui": "npm run dev -w @aifig/canvas",
    "mcp": "node bin/aifig.mjs mcp",
    "aifig": "node bin/aifig.mjs",
    "build": "npm run build -w @aifig/canvas",
    "start": "npm run build && node bin/aifig.mjs core",
    "typecheck": "tsc -p packages/shared && tsc -p packages/core && tsc -p packages/cli && tsc -p packages/canvas-engine && tsc -p apps/canvas",
    "lint": "oxlint packages apps",
    "desktop": "npm run build && electron apps/desktop",
    "desktop:dev": "AIFIG_DESKTOP_URL=http://127.0.0.1:47820 electron apps/desktop",
    "desktop:build": "node apps/desktop/scripts/build.mjs",
    "test:api": "node scripts/api-regressions.mjs",
    "test:skills": "node scripts/skills-tests.mjs",
    "test:security": "node scripts/security-checks.mjs",
    "test:aesthetics": "node scripts/aesthetics.mjs",
    "test:aesthetics:update": "node scripts/aesthetics.mjs --update",
    "test:e2e": "node scripts/engine-e2e.mjs",
    "test:data-safety": "node --import tsx --test tests/data-safety/*.test.ts && node scripts/data-safety.mjs",
    "test:onboarding": "node scripts/onboarding-e2e.mjs"
  },
  "dependencies": {
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2"
  }
}
