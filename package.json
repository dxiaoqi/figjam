{
  "name": "ai-figma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n core,ui -c magenta,cyan \"npm:core\" \"npm:ui\"",
    "core": "node bin/aifig.mjs core",
    "ui": "vite",
    "mcp": "node bin/aifig.mjs mcp",
    "aifig": "node bin/aifig.mjs",
    "build": "vite build",
    "start": "npm run build && node bin/aifig.mjs core",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node-app.json",
    "lint": "oxlint src"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@resvg/resvg-js": "^2.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "lib0": "^0.2.117",
    "lucide-react": "^1.47.0",
    "nanoid": "^6.0.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tldraw": "^5.4.2",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "description": "A local-first infinite canvas shared by people and AI agents (Phase 0 prototype)",
  "bin": {
    "aifig": "bin/aifig.mjs"
  }
}
