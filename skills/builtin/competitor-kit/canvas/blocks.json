{
  "$schema": "https://aifig.dev/schemas/skill-blocks-1.json",
  "version": 1,
  "types": {
    "competitor": {
      "label": "Competitor",
      "plural": "Competitors",
      "base": "card",
      "color": "blue",
      "icon": "Building2",
      "glyph": "▣",
      "description": "A competing product.",
      "fields": [
        { "key": "segment", "label": "Segment", "kind": "text", "placeholder": "Design teams" },
        { "key": "positioning", "label": "Positioning", "kind": "enum", "options": ["budget", "mainstream", "premium"] },
        { "key": "price", "label": "Price", "kind": "number", "unit": "$/seat/mo" },
        { "key": "url", "label": "Website", "kind": "text" }
      ],
      "template": { "rows": ["segment", "positioning", "price"], "summary": ["url"] }
    },
    "feature": {
      "label": "Feature",
      "plural": "Features",
      "base": "sticky",
      "color": "yellow",
      "icon": "Layers",
      "glyph": "◆",
      "description": "Whether a competitor has a feature.",
      "fields": [
        { "key": "status", "label": "Status", "kind": "enum", "options": ["has", "partial", "missing"], "default": "has" },
        { "key": "competitor", "label": "Competitor", "kind": "text" }
      ]
    },
    "launch": {
      "label": "Launch",
      "plural": "Launches",
      "base": "sticky",
      "color": "orange",
      "icon": "Rocket",
      "glyph": "▲",
      "description": "A dated release or event.",
      "fields": [
        { "key": "date", "label": "Date", "kind": "text", "placeholder": "2026-03" },
        { "key": "competitor", "label": "Competitor", "kind": "text" }
      ]
    }
  },
  "relations": [
    { "from": "feature", "to": "competitor", "relation": "belongs to" },
    { "from": "launch", "to": "competitor", "relation": "belongs to" },
    { "from": "competitor", "to": "competitor", "relation": "competes with" }
  ],
  "layouts": [
    { "id": "positioning-matrix", "label": "Positioning matrix", "intent": "matrix", "types": ["competitor"], "rows": "segment", "cols": "positioning" },
    { "id": "feature-grid", "label": "Feature grid", "intent": "matrix", "types": ["feature"], "rows": "competitor", "cols": "status" },
    { "id": "launches", "label": "Launch timeline", "intent": "timeline", "types": ["launch"], "field": "date" }
  ],
  "actions": [
    {
      "id": "fetch-homepage",
      "label": "Fetch homepage",
      "description": "Read the competitor's website and add a summary sticky for review.",
      "tool": "fetch.fetch",
      "args": { "url": "{{fields.url}}", "max_length": 1500 },
      "appliesTo": ["competitor"],
      "output": { "mode": "blocks" }
    }
  ],
  "prompts": [
    { "id": "compare", "label": "Compare competitors", "file": "prompts/compare.md" }
  ]
}
